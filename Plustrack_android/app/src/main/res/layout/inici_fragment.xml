<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECBA15">

    <View
        android:id="@+id/cuadradoBlanco"
        android:layout_width="420dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/border_top_bottom"
        app:layout_constraintTop_toBottomOf="@+id/logo_plustrack"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/logo_plustrack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="56dp"
        android:src="@drawable/logo_plustrack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnCercar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/border_top_bottom"
        android:scaleType="fitCenter"
        android:src="@drawable/lupa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo_plustrack"
        android:layout_marginStart="30dp"
        android:layout_marginTop="40dp"/>

    <EditText
        android:id="@+id/etIdProducte"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:background="@drawable/edittext_rounded_total"
        android:hint="Usuari"
        android:padding="10dp"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@+id/btnCercar"
        app:layout_constraintTop_toTopOf="@+id/btnCercar"
        app:layout_marginTop="10dp" />

    <ImageButton
        android:id="@+id/imgTelefon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="fitCenter"
        android:src="@drawable/llamar"
        app:layout_constraintStart_toStartOf="@+id/btnContactar"
        app:layout_constraintTop_toTopOf="@+id/btnContactar"/>

    <TextView
        android:id="@+id/btnContactar"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:background="@drawable/border_top_bottom"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="10dp"
        android:text="Contactar amb PlusTrack"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/btnCercar"
        app:layout_constraintTop_toBottomOf="@+id/etIdProducte"
        android:layout_marginVertical="50dp"/>

    <TextView
        android:id="@+id/btnFAQs"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:background="@drawable/border_top_bottom"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="10dp"
        android:text="Preguntes Frequents"
        android:textColor="#000000"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/btnCercar"
        app:layout_constraintTop_toBottomOf="@+id/btnContactar"
        app:layout_marginTop="10dp"
        app:layout_marginStart="20dp"
        android:layout_marginVertical="20dp"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigationView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="0dp"
        app:itemIconSize="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentContainerView"
        app:menu="@menu/bottom_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>